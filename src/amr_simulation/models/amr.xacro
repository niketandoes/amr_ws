<?xml version="1.0"?>
<!--
  AMR Description (Xacro)
  Differential-drive mobile robot with parameterized prefix for multi-robot namespacing.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="amr">
    <!-- IMPORTANT: Assumes robot_name is passed WITH a trailing slash from the launch file (e.g., 'amr1/') -->
    <xacro:arg name="robot_name" default=""/>
    
    <link name="$(arg robot_name)base_footprint"/>

    <joint name="$(arg robot_name)base_joint" type="fixed">
        <parent link="$(arg robot_name)base_footprint"/>
        <child link="$(arg robot_name)base_link"/>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </joint>

    <link name="$(arg robot_name)base_link">
        <visual>
            <geometry>
                <box size="0.6 0.5 0.2"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.6 0.5 0.2"/>
            </geometry>
        </collision>
        <inertial>
            <!-- FIX: Shifted Center of Mass forward by 0.1m to prevent backward tipping -->
            <origin xyz="0.1 0 0" rpy="0 0 0"/>
            <mass value="10.0"/>
            <inertia ixx="0.24" ixy="0" ixz="0" iyy="0.33" iyz="0" izz="0.5"/>
        </inertial>
    </link>

    <!-- Wheels -->
    <xacro:macro name="wheel" params="side y_reflect">
        <link name="$(arg robot_name)${side}_wheel">
            <visual>
                <geometry>
                    <cylinder radius="0.1" length="0.05"/>
                </geometry>
                <material name="black">
                    <color rgba="0 0 0 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="0.1" length="0.05"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="1.0"/>
                <inertia ixx="0.0027" ixy="0" ixz="0" iyy="0.0027" iyz="0" izz="0.005"/>
            </inertial>
        </link>
        <joint name="$(arg robot_name)${side}_wheel_joint" type="continuous">
            <parent link="$(arg robot_name)base_link"/>
            <child link="$(arg robot_name)${side}_wheel"/>
            <origin xyz="0 ${y_reflect * 0.275} 0" rpy="-1.570796 0 0"/>
            <axis xyz="0 0 1"/>
        </joint>
    </xacro:macro>

    <xacro:wheel side="left" y_reflect="1"/>
    <xacro:wheel side="right" y_reflect="-1"/>

    <!-- Front Caster wheel -->
    <link name="$(arg robot_name)caster_wheel">
        <visual>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.5"/>
            <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
        </inertial>
    </link>
    <joint name="$(arg robot_name)caster_joint" type="fixed">
        <parent link="$(arg robot_name)base_link"/>
        <child link="$(arg robot_name)caster_wheel"/>
        <origin xyz="0.2 0 -0.05" rpy="0 0 0"/>
    </joint>

    <!-- Lidar -->
    <link name="$(arg robot_name)lidar_link">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.05"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.05"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>
    <joint name="$(arg robot_name)lidar_joint" type="fixed">
        <parent link="$(arg robot_name)base_link"/>
        <child link="$(arg robot_name)lidar_link"/>
        <origin xyz="0 0 0.125" rpy="0 0 0"/>
    </joint>

    <gazebo reference="$(arg robot_name)lidar_link">
        <sensor name="lidar" type="gpu_lidar">
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <topic>/$(arg robot_name)scan</topic>
            <gz_frame_id>$(arg robot_name)lidar_link</gz_frame_id>
            <!-- FIX: Added explicit ROS 2 frame ID -->
            <frame_id>$(arg robot_name)lidar_link</frame_id>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.12</min>
                    <max>10.0</max>
                    <resolution>0.015</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
        </sensor>
    </gazebo>

    <gazebo reference="$(arg robot_name)caster_wheel">
        <!-- FIX: Corrected Gazebo SDF friction parameter syntax -->
        <mu1>0.001</mu1>
        <mu2>0.001</mu2>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>$(arg robot_name)left_wheel_joint</left_joint>
            <right_joint>$(arg robot_name)right_wheel_joint</right_joint>
            <wheel_separation>0.55</wheel_separation>
            <wheel_radius>0.1</wheel_radius>
            <odom_publish_frequency>50</odom_publish_frequency>
            <topic>/$(arg robot_name)cmd_vel</topic>
            <odom_topic>/$(arg robot_name)odom</odom_topic>
            <tf_topic>/$(arg robot_name)tf</tf_topic>
            <frame_id>$(arg robot_name)odom</frame_id>
            <child_frame_id>$(arg robot_name)base_footprint</child_frame_id>
        </plugin>
        
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>/$(arg robot_name)joint_states</topic>
        </plugin>
    </gazebo>
</robot>