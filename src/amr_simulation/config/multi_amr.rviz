Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Global Map
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /amr1/map
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /amr1/robot_description
      Name: AMR1 Model
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: AMR1 Scan
      Topic:
        Value: /amr1/scan
      Color: 255; 50; 50
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /amr2/robot_description
      Name: AMR2 Model
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: AMR2 Scan
      Topic:
        Value: /amr2/scan
      Color: 50; 255; 50
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /amr3/robot_description
      Name: AMR3 Model
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: AMR3 Scan
      Topic:
        Value: /amr3/scan
      Color: 50; 150; 255
      Value: true
  Global Options:
    Fixed Frame: map
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
Window Geometry:
  Height: 800
  Width: 1200
